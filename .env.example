# ═══════════════════════════════════════════════════════════════════════════
# Drive Search Assistant — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="Drive Search Assistant"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ── LLM Provider ────────────────────────────────────────────────────────
# Choose "openai", "anthropic", "gemini", or "groq"
LLM_PROVIDER=openai

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o

# Anthropic (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# LLM_MODEL=claude-3-5-sonnet-20240620

# Google Gemini (if LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-1.5-flash

# Groq (if LLM_PROVIDER=groq)
# GROQ_API_KEY=gsk-your-groq-key-here
# LLM_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Google Drive ─────────────────────────────────────────────────────────
# Option 1: Path to service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option 2: Raw JSON string (for Railway / Render deployments)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: Restrict search to a specific Drive folder
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

DRIVE_PAGE_SIZE=20
DRIVE_MAX_RESULTS=50

# ── Memory ───────────────────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=20

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
API_TIMEOUT=120
